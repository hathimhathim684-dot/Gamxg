<!DOCTYPE html>
<html lang="ta">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Bus Simulator Tamil Nadu V1.2.3 Final</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{background:#000;overflow:hidden;font-family:Arial}
canvas{display:block;width:100vw;height:100vh}
#topBar{position:fixed;top:0;left:0;width:100%;height:50px;background:linear-gradient(90deg,#003200,#00AA00);display:flex;justify-content:space-between;align-items:center;padding:0 12px;color:white;font-weight:bold;z-index:10}
#districtBar{position:fixed;top:50px;left:0;width:100%;background:#FFEB00;color:#000;text-align:center;padding:4px;font-size:12px;font-weight:bold;z-index:10}
#controls{position:fixed;bottom:15px;left:0;width:100%;display:flex;justify-content:space-around;z-index:10}
.btn{width:65px;height:65px;background:rgba(255,255,255,0.25);border:2px solid #fff;border-radius:50%;color:white;font-size:24px;display:flex;justify-content:center;align-items:center}
.btn:active{transform:scale(0.9)}
#settingsBtn{position:fixed;top:85px;right:12px;width:42px;height:42px;background:rgba(0,0,0,0.7);border:2px solid #fff;border-radius:50%;display:flex;justify-content:center;align-items:center;color:white;font-size:20px;z-index:11}
#settingsScreen{position:fixed;top:0;left:0;width:100%;height:100%;background:#0a1931;z-index:100;display:none;overflow-y:auto}
.header{background:linear-gradient(180deg,#1a365d,#0a1931);padding:16px;text-align:center;border-bottom:3px solid #FFD700}
.header h1{color:#FFD700;font-size:23px}
.card{background:#0f2440;margin:10px 12px;border-radius:14px;padding:13px;border:1px solid #1e3a5f}
.card-title{color:#00e5ff;font-weight:bold;font-size:13px;margin-bottom:10px}
.row{display:flex;justify-content:space-between;align-items:center;margin:10px 0;font-size:12px;color:#ddd}
.sbtn{padding:6px 14px;border-radius:20px;background:#1a3a5f;border:none;color:#ccc;font-size:11px}
.sbtn.active{background:#00e5ff;color:#000;font-weight:bold}
.bottom{display:flex;gap:10px;margin:16px 12px}
.bottom button{flex:1;padding:13px;border-radius:10px;border:none;font-weight:bold}
.reset{background:#1e1e1e;color:#888;border:1px solid #444!important}
.apply{background:#00a99d;color:#FFEB00}
</style>
</head>
<body>
<div id="topBar"><span>🚌 TNSTC</span><span id="score">Pass:0</span><span id="speed">0 KM/H</span></div>
<div id="districtBar">📍 நெல்லிக்குப்பம் - NELLIKUPPAM</div>
<div id="settingsBtn" onclick="document.getElementById('settingsScreen').style.display='block'">⚙️</div>
<canvas id="game"></canvas>
<div id="controls">
<div class="btn" id="left">◀️</div>
<div class="btn" id="brake">🛑</div>
<div class="btn" id="acc">▶️</div>
<div class="btn" id="horn">📯</div>
</div>
<div id="settingsScreen">
<div class="header"><h1>Bus Simulator<br>Tamil Nadu</h1><p>Version 1.2.3 • Offline Mode</p></div>
<div class="card"><div class="card-title">🎮 GRAPHICS - HIGH</div><div class="row"><span>60 FPS - Shadows ON</span></div></div>
<div class="card"><div class="card-title">🌦️ WEATHER</div><div class="row"><span>Day/Night + Rainy/Foggy</span></div></div>
<div class="bottom"><button class="reset" onclick="document.getElementById('settingsScreen').style.display='none'">CLOSE</button><button class="apply" onclick="document.getElementById('settingsScreen').style.display='none'">APPLY</button></div>
</div>
<script>
const canvas=document.getElementById('game'); const ctx=canvas.getContext('2d');
function resize(){canvas.width=innerWidth;canvas.height=innerHeight;} resize(); addEventListener('resize',resize);
let worldX=11200, busSpeed=140; const D=[{name:"Chennai",tamil:"சென்னை",x:0,lm:"Marina"},{name:"Villupuram",tamil:"விழுப்புரம்",x:5000,lm:"Flyover"},{name:"Nellikuppam",tamil:"நெல்லிக்குப்பம்",x:11200,lm:"Sugar Factory ⭐"},{name:"Cuddalore",tamil:"கடலூர்",x:12800,lm:"Main Hub"},{name:"Madurai",tamil:"மதுரை",x:28500,lm:"Meenakshi"},{name:"Kanniyakumari",tamil:"கன்னியாகுமரி",x:35000,lm:"Rock"}];
let keys={}, v=[]; for(let i=0;i<10;i++) v.push({x:Math.random()*36000,s:1+Math.random()*2});
function draw(){let g=ctx.createLinearGradient(0,0,0,innerHeight);g.addColorStop(0,'#0a3d8f');g.addColorStop(1,'#87ceeb');ctx.fillStyle=g;ctx.fillRect(0,0,canvas.width,canvas.height);ctx.fillStyle='#FFD700';ctx.beginPath();ctx.arc(canvas.width-100,80,30,0,7);ctx.fill();ctx.fillStyle='#2e7d32';ctx.fillRect(0,canvas.height-200,canvas.width,200);ctx.fillStyle='#212121';ctx.fillRect(0,canvas.height-150,canvas.width,150);ctx.fillStyle='#ffeb00';for(let i=0;i<canvas.width+100;i+=60)ctx.fillRect(i-worldX%60,canvas.height-80,30,5);D.forEach(d=>{let x=d.x-worldX;if(x<-200||x>canvas.width+200)return;ctx.fillStyle=d.name=='Nellikuppam'?'#8B4513':'#0d2a5a';ctx.fillRect(x,canvas.height-320,210,90);ctx.fillStyle='#FFEB00';ctx.font='bold 13px Arial';ctx.fillText(d.name.toUpperCase(),x+10,canvas.height-300);ctx.fillStyle='#fff';ctx.font='11px Arial';ctx.fillText(d.tamil,x+10,canvas.height-283);});v.forEach(o=>{let x=o.x-worldX;ctx.fillStyle='#fff';ctx.fillRect(x,canvas.height-120,60,25);o.x-=o.s;if(o.x<-500)o.x=36000;});let bx=canvas.width/2-75,by=canvas.height-150;ctx.fillStyle='#006400';ctx.fillRect(bx,by,150,55);ctx.fillStyle='#FFD700';ctx.fillRect(bx,by+22,150,4);ctx.fillStyle='#FFEB00';ctx.font='bold 12px Arial';ctx.fillText('TNSTC',bx+50,by-5);ctx.fillStyle='#111';ctx.beginPath();ctx.arc(bx+20,by+55,11,0,7);ctx.fill();ctx.beginPath();ctx.arc(bx+120,by+55,11,0,7);ctx.fill();let c=D[2];let min=Infinity;D.forEach(d=>{let diff=Math.abs(d.x-worldX);if(diff<min){min=diff;c=d;}});document.getElementById('districtBar').innerText='📍 '+c.tamil+' - '+c.name;document.getElementById('speed').innerText=Math.floor(busSpeed*15)+' KM/H';}
function loop(){if(keys['w'])busSpeed+=0.07;if(keys['s'])busSpeed-=0.18;if(keys['a'])worldX-=5;busSpeed*=0.988;if(busSpeed>7)busSpeed=7;if(busSpeed<0)busSpeed=0;worldX+=busSpeed;draw();requestAnimationFrame(loop);}
addEventListener('keydown',e=>keys[e.key.toLowerCase()]=true);addEventListener('keyup',e=>keys[e.key.toLowerCase()]=false);
document.getElementById('left').ontouchstart=e=>{e.preventDefault();keys['a']=true};document.getElementById('left').ontouchend=()=>keys['a']=false;
document.getElementById('acc').ontouchstart=e=>{e.preventDefault();keys['w']=true};document.getElementById('acc').ontouchend=()=>keys['w']=false;
document.getElementById('brake').ontouchstart=e=>{e.preventDefault();keys['s']=true};document.getElementById('brake').ontouchend=()=>keys['s']=false;
loop();
</script>
</body>
</html>
